<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="prog2.vista.FrmVisualitzarUsuaris">
  <grid id="27dc6" binding="pnlVisualitzarUsuaris" layout-manager="GridBagLayout">
    <constraints>
      <xy x="20" y="20" width="593" height="384"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <scrollpane id="cb96f" binding="scroll">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
          <gridbag weightx="1.0" weighty="1.0"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="92b43" class="javax.swing.JList" binding="lstUsuaris">
            <constraints/>
            <properties>
              <model/>
            </properties>
          </component>
        </children>
      </scrollpane>
      <component id="2247a" class="javax.swing.JButton" binding="btnSortir">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties>
          <text value="Sortir"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
